# Copy to .env and fill in. Never commit .env.
# On Render, set these in the service's Environment tab instead.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_RETRIES=2
MAX_INPUT_TOKENS=2000
REPLY_MAX_TOKENS=700
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_TOKENS=3000
SESSION_TTL_MINUTES=60
MAX_SESSIONS=500

# Week 4 - leave empty to keep chats in memory (local dev).
# Supabase: Project -> Connect -> "Session pooler" URI, with your DB password filled in.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Comma-separated frontend URLs allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Optional: also allow Vercel preview URLs
# CORS_ORIGIN_REGEX=https://indigo-ai-.*\.vercel\.app
